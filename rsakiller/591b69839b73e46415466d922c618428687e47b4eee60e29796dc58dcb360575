from Crypto.Util.number import *
import binascii
import gmpy2

flag = '****************************************'
hex_flag=int(flag.encode("hex"),16)

p=getPrime(100)
q=gmpy2.next_prime(p)
r=gmpy2.next_prime(q)
s=gmpy2.next_prime(r)
n=p*q*r*s

e=0x10001
c=pow(hex_flag,e,n)

print("n=",hex(n))
print("e=",hex(e))
print("c=",hex(c))

